# ─────────────────────────────────────────────────────────────────────────────
# Compliance Toolkit — environment
#
#   cp .env.example .env
#
# Validated at boot by src/config/env.ts; the process refuses to start on a bad
# value rather than failing at the first request. Anything left commented out
# falls back to the default shown beside it.
#
# Full production runbook: DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Public origin of this API. Used to build links in outbound email, so a wrong
# value produces password-reset links that go nowhere.
APP_BASE_URL=http://localhost:4000

# Comma-separated browser origins allowed to call the API. The Vite dev server
# proxies /api from :5173, so in development the browser stays same-origin and
# this only matters if you call the API from another host.
# Ignored entirely when SERVE_WEB=true.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ── Database (Supabase Postgres) ─────────────────────────────────────────────
#
# Two strings, not interchangeable:
#   DATABASE_URL  transaction pooler, port 6543 — the app at runtime
#   DIRECT_URL    session pooler,     port 5432 — prisma migrate
#
# Supabase dashboard: Project Settings → Database → Connection string.
#
#   ?pgbouncer=true is mandatory on the pooled URL. Without it Prisma uses
#   prepared statements, which a transaction pooler cannot honour, and you get
#   intermittent `prepared statement "s0" already exists` under load.
#
#   connection_limit is per instance — multiply by replica count and stay under
#   the project's pool size. 10 for a long-running container, 1 for serverless.
#
#   Migrations must not use the pooled URL: DDL and Prisma's advisory lock both
#   need a real session. schema.prisma already routes them to DIRECT_URL.
#
# Prefer the *session pooler* over Supabase's "Direct connection" for
# DIRECT_URL — the latter is IPv6-only, and GitHub Actions runners are IPv4.
DATABASE_URL="postgresql://postgres.ciulqktarpydorkkfmqh:pAgPODj3ZJE7Hh73@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.ciulqktarpydorkkfmqh:pAgPODj3ZJE7Hh73@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# No Supabase project yet? `docker compose up -d` starts Postgres 17 on 5433.
# Comment out the two lines above and uncomment these:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/compliance?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/compliance?schema=public"

# Or the local Supabase stack (`supabase start`, see supabase/config.toml):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"


# ── Supabase Storage (evidence files) ────────────────────────────────────────
#
# Both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY must be set to switch the
# storage driver from local disk to Supabase; either one missing falls back to
# ./storage and logs a warning at boot. `GET /ready` reports which is live.
#
# Create the bucket with supabase/setup.sql (`npm run supabase:bootstrap`), or
# by hand: Storage → New bucket, private, 25 MB limit.
#
# The service_role key bypasses row-level security. Server-side only — it must
# never reach the browser bundle. Project Settings → API → service_role.
SUPABASE_URL=https://ciulqktarpydorkkfmqh.supabase.co
VITE_SUPABASE_URL=https://ciulqktarpydorkkfmqh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNpdWxxa3RhcnB5ZG9ya2tmbXFoIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODIzNTU3MSwiZXhwIjoyMTAzODExNTcxfQ.KPFXuafObmf1oA5YzEWMNsOLa--YKHawxN0YdQDEY9s
SUPABASE_STORAGE_BUCKET=compliance-evidence

# Where the local-disk driver writes when Supabase is not configured.
# LOCAL_STORAGE_DIR=./storage


# ── Auth ─────────────────────────────────────────────────────────────────────
#
# This app runs its own JWT auth — not Supabase Auth. Generate real secrets:
#   openssl rand -base64 48
#
# Rotating JWT_ACCESS_SECRET invalidates live access tokens (clients re-auth
# silently via refresh). Rotating JWT_REFRESH_SECRET signs everyone out.
# Minimum 16 characters; a placeholder in production is an account takeover.
JWT_ACCESS_SECRET=hMmW6CY+h/Vuv/Ygl8sWmmrCsf+ZkfywlzfvF45xMA8DWJWlqRAcZIlOJMnfuTzA
JWT_REFRESH_SECRET=w++9CgcC6k//WKF58BexRVchRmf3aV754QPTkjB3fuI+1qf3w+AKzxrI3F0Y/UcU
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12


# ── Mail ─────────────────────────────────────────────────────────────────────
#
# SMTP_HOST unset ⇒ the console driver, which logs the message instead of
# sending it. Fine for development, never for production reminders.
# SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Compliance Toolkit <no-reply@example.com>"


# ── Web dashboard ────────────────────────────────────────────────────────────
#
# true serves web/dist from this origin — one artifact, no CORS. Leave false if
# you host the front end separately (Vercel, Cloudflare Pages, S3+CloudFront)
# or are running the Vite dev server.
SERVE_WEB=true
WEB_DIST_DIR=./web/dist
APP_BASE_URL=https://complaudi.regibiz.in

# ── Scheduled jobs ───────────────────────────────────────────────────────────
#
# Keep ENABLE_CRON=false in production: the in-process scheduler is a
# development convenience and every replica would fire it, so reminders go out
# once per instance. Production drives jobs from an external scheduler
# (GitHub Actions, a platform cron, or Supabase pg_cron) hitting
# POST /internal/jobs/:name. See DEPLOYMENT.md.
ENABLE_CRON=false

# Shared secret for that endpoint — required before the route is exposed at
# all. Minimum 24 characters: openssl rand -base64 48
# JOB_TRIGGER_SECRET=

REMINDER_CRON=0 8 * * *
TIMEZONE=Asia/Kolkata

# Days before a due date that a reminder goes out; 0 is the due date itself.
REMINDER_OFFSET_DAYS=30,15,7,3,1,0
# ── Razorpay billing ─────────────────────────────────────────────────────────
# Fill these in yourself. The secret key must never reach the frontend.
# Start with TEST keys (rzp_test_*). With RAZORPAY_TEST_MODE=true the app
# refuses to boot if RAZORPAY_KEY_ID is a live (rzp_live_*) key.
# Empty keys mean billing is off: the endpoints serve 503 BILLING_NOT_CONFIGURED.
#RAZORPAY_KEY_ID=rzp_live_TWNhK1YsNLKODG
#RAZORPAY_KEY_SECRET=jEr1uYlLXp67IeLygXoVKTIf
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true

# Single product: an annual plan sold at ₹699/year.
RAZORPAY_PLAN_AMOUNT_PAISE=69900
RAZORPAY_PLAN_NAME=Annual plan
RAZORPAY_PLAN_PERIOD_DAYS=365
RAZORPAY_CURRENCY=INR
