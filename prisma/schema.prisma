// Compliance Toolkit — data model
// Postgres (Supabase). Runtime uses the pooled connection; migrations use DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum EntityType {
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OPC
  LLP
  PARTNERSHIP
  PROPRIETORSHIP
  SECTION_8
}

/// Roles within one organisation. Tenant isolation is by organisation and is
/// never crossed — a SUPER_ADMIN is the top of *their* firm, not the installation.
enum UserRole {
  /// Sees every company in the organisation, manages users and grants access.
  SUPER_ADMIN
  /// Sees every company in the organisation; cannot manage users or grants.
  ADMIN
  /// Practitioner. Sees only the companies they have been granted, and works them.
  CA
  /// A client's own login. Sees only their company; uploads evidence, cannot reshape the profile.
  COMPANY_OWNER
  /// Read-only, on granted companies only.
  VIEWER
}

enum Authority {
  MCA
  GST
  INCOME_TAX
  MSME
  LABOUR
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ItemStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
  WAIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

/// How completion of an obligation must be proved. See src/engine/types.ts.
enum EvidenceLevel {
  REQUIRED
  ATTEST
  NONE
}

enum GstFilingFrequency {
  MONTHLY
  QRMP
  COMPOSITION
}

enum MsmeCategory {
  MICRO
  SMALL
  MEDIUM
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------- tenancy

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// Set for self-service trials. Null means a full account with no expiry, so
  /// existing organisations are unaffected.
  trialEndsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  companies Company[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  name           String
  /// Contact number captured at self-service signup.
  phone          String?
  /// The user's default capability. A grant may narrow or widen it per company.
  role           UserRole @default(VIEWER)
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  /// Access tokens issued before this are refused. Without it a password reset
  /// would leave any live session working until its token expired.
  passwordChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  memberships   CompanyMembership[] @relation("MembershipUser")
  grantsMade    CompanyMembership[] @relation("MembershipGrantedBy")
  assignedTasks Task[]         @relation("TaskAssignee")
  uploads       Document[]
  notifications Notification[]

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Who may see and work a given company.
///
/// SUPER_ADMIN and ADMIN see every company in the organisation and need no row
/// here. Everyone else sees only the companies they hold a membership for, which
/// is what lets a client's own login see nothing but their own entity.
model CompanyMembership {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  /// Capability on this company specifically — a practitioner may be CA on one
  /// client and VIEWER on another.
  role        UserRole
  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grantedBy User?   @relation("MembershipGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("company_memberships")
}

// ---------------------------------------------------------------- company profile

model Company {
  id             String     @id @default(uuid())
  organizationId String
  legalName      String
  brandName      String?
  entityType     EntityType
  cin            String?    // Pvt Ltd / Public / OPC / Section 8
  llpin          String?    // LLP
  pan            String?
  tan            String?
  incorporationDate DateTime? @db.Date

  // profile drivers for the rules engine
  stateCode           String   // ISO-ish state code, e.g. "TN", "MH", "KA"
  industry            String?
  employeeCount       Int      @default(0)
  annualTurnover      BigInt   @default(0) // INR
  paidUpCapital       BigInt   @default(0) // INR
  cashTransactionRatioBelow5Pct Boolean @default(true) // drives the 1cr vs 10cr tax-audit threshold
  hasForeignTransactions Boolean @default(false)       // Form 3CEB / transfer pricing
  acceptsDeposits        Boolean @default(false)       // DPT-3
  isListed               Boolean @default(false)
  buysFromMsmeSuppliers  Boolean @default(true)        // MSME-1 half-yearly
  financialYearEndMonth  Int     @default(3)           // 3 = March (Indian FY)
  profileConfirmedAt     DateTime?  // set when user confirms/edits their profile

  /// Registrations the entity holds rather than obligations it owes. They drive
  /// no rules today — they are what a reviewer asks for first, so the dashboard
  /// shows them. Formats vary by issuing office, so none is asserted here.
  dpiitRecognitionNumber String?   // DPIIT / Startup India recognition
  dpiitRecognisedOn      DateTime? @db.Date
  epfoCode               String?   // EPFO establishment code (PF)
  esicCode               String?   // ESIC employer code
  agmDate                DateTime? @db.Date            // drives AOC-4 / MGT-7 offsets
  isActive               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships     CompanyMembership[]
  directors       Director[]
  gstRegistrations GstRegistration[]
  msmeRegistration MsmeRegistration?
  applicabilities ComplianceApplicability[]
  items           ComplianceItem[]
  documents       Document[]
  scoreSnapshots  ComplianceScoreSnapshot[]

  @@unique([organizationId, legalName])
  @@index([organizationId])
  @@map("companies")
}

model Director {
  id        String   @id @default(uuid())
  companyId String
  name      String
  din       String?  // DIN / DPIN
  email     String?
  designation String @default("Director")
  appointedOn DateTime? @db.Date
  resignedOn  DateTime? @db.Date
  isResident  Boolean  @default(true)
  /// A filing that needs signing cannot go out on an expired certificate, so the
  /// expiry is what matters here rather than the certificate itself.
  dscExpiresOn DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("directors")
}

model GstRegistration {
  id           String             @id @default(uuid())
  companyId    String
  gstin        String
  stateCode    String
  legalName    String?
  filingFrequency GstFilingFrequency @default(MONTHLY)
  isTdsDeductor   Boolean         @default(false) // GSTR-7
  isEcommerceOperator Boolean     @default(false) // GSTR-8
  registeredOn DateTime?          @db.Date
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, gstin])
  @@index([companyId])
  @@map("gst_registrations")
}

model MsmeRegistration {
  id           String       @id @default(uuid())
  companyId    String       @unique
  udyamNumber  String
  category     MsmeCategory
  registeredOn DateTime?    @db.Date
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("msme_registrations")
}

// ---------------------------------------------------------------- engine output

/// Snapshot of why a rule does / does not apply to a company. Auditable.
model ComplianceApplicability {
  id          String   @id @default(uuid())
  companyId   String
  ruleCode    String
  applicable  Boolean
  reasons     Json     // [{ label, passed, negated }]
  evaluatedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ruleCode])
  @@index([companyId, applicable])
  @@map("compliance_applicabilities")
}

/// One row per (company, rule, period) — this is the compliance calendar.
model ComplianceItem {
  id          String     @id @default(uuid())
  companyId   String
  ruleCode    String
  title       String
  authority   Authority
  category    String
  form        String?
  legalReference String
  severity    Severity
  periodKey   String     // stable idempotency key, e.g. "FY2025-26", "2025-08", "FY2025-26-Q1"
  periodLabel String
  periodStart DateTime   @db.Date
  periodEnd   DateTime   @db.Date
  dueDate     DateTime   @db.Date
  status      ItemStatus @default(UPCOMING)
  completedAt DateTime?
  waivedReason String?
  penaltyNote String?
  evidenceRequired String[]      @default([])
  evidenceLevel    EvidenceLevel @default(NONE)

  /// Set when an ATTEST obligation is closed with a declaration rather than a
  /// document. Kept on the item so the claim, its author and its timestamp
  /// travel with the record an auditor will actually read.
  attestationText String?
  attestedById    String?
  attestedAt      DateTime?

  /// The person who signed the evidence, for rules whose document carries a
  /// human signature. Software cannot verify a scanned signature, so a named
  /// accountable person is the control that replaces it.
  signatoryName String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task      Task?
  documents Document[]
  notifications Notification[]

  @@unique([companyId, ruleCode, periodKey])
  @@index([companyId, dueDate])
  @@index([companyId, status])
  @@index([dueDate, status])
  @@map("compliance_items")
}

model Task {
  id               String     @id @default(uuid())
  complianceItemId String     @unique
  companyId        String
  title            String
  description      String?
  status           TaskStatus @default(TODO)
  assigneeId       String?
  dueDate          DateTime   @db.Date
  checklist        Json       @default("[]") // [{ id, label, done }]
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  complianceItem ComplianceItem @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  documents      Document[]

  @@index([companyId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Document {
  id               String   @id @default(uuid())
  companyId        String
  complianceItemId String?
  taskId           String?
  fileName         String
  storageKey       String   @unique
  storageDriver    String   @default("supabase") // supabase | local
  mimeType         String
  sizeBytes        Int
  sha256           String
  label            String?
  uploadedById     String?
  createdAt        DateTime @default(now())

  /// Recorded at upload from the file's actual contents, not the client's claim.
  detectedType        String?
  pdfPages            Int?
  hasDigitalSignature Boolean  @default(false)
  /// Common names read out of the signing certificates, best effort.
  signers             String[] @default([])
  signedAt            DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complianceItem ComplianceItem? @relation(fields: [complianceItemId], references: [id], onDelete: SetNull)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy     User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([complianceItemId])
  @@map("documents")
}

model Notification {
  id               String              @id @default(uuid())
  userId           String?
  complianceItemId String?
  channel          NotificationChannel @default(EMAIL)
  kind             String              // e.g. "DUE_IN_7", "OVERDUE"
  subject          String
  body             String
  status           NotificationStatus  @default(PENDING)
  error            String?
  sentAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime            @default(now())

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  complianceItem ComplianceItem? @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)

  @@unique([complianceItemId, userId, kind])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  actorEmail     String?
  action         String   // e.g. "company.create", "task.complete"
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One row per scheduled job execution.
///
/// The unique (jobName, scheduledFor) is how concurrent replicas agree on who
/// runs the job: whoever inserts the row first owns it, everyone else backs off.
/// It doubles as the job history for monitoring and alerting.
model JobRun {
  id           String    @id @default(uuid())
  jobName      String
  /// The logical slot this run belongs to — the date for a daily job.
  scheduledFor DateTime  @db.Date
  status       JobStatus @default(RUNNING)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  result       Json?
  error        String?
  /// Which container/pod claimed it, for tracing a failure back to a host.
  claimedBy    String?

  @@unique([jobName, scheduledFor])
  @@index([jobName, startedAt])
  @@map("job_runs")
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model ComplianceScoreSnapshot {
  id         String   @id @default(uuid())
  companyId  String
  score      Int
  band       String   // A | B | C | D
  breakdown  Json
  capturedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, capturedAt])
  @@map("compliance_score_snapshots")
}
