generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  /// Set for self-service trials. Null means a full account with no expiry, so
  /// existing organisations are unaffected.
  trialEndsAt     DateTime?
  /// When a self-service trial signed up. Null for accounts that never began on
  /// a trial. Kept so trial→paid conversion can be computed honestly platform-wide:
  /// the denominator is every organisation that actually started on a trial.
  trialSignedUpAt DateTime?
  auditLogs       AuditLog[]
  companies       Company[]
  users           User[]
  payments        Payment[]

  @@map("organizations")
}

model User {
  id                String               @id @default(uuid())
  organizationId    String
  email             String               @unique
  passwordHash      String
  name              String
  /// The user's default capability. A grant may narrow or widen it per company.
  role              UserRole             @default(VIEWER)
  isActive          Boolean              @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  /// Access tokens issued before this are refused. Without it a password reset
  /// would leave any live session working until its token expired.
  passwordChangedAt DateTime             @default(now())
  /// Contact number captured at self-service signup.
  phone             String?
  /// ── single active session ───────────────────────────────────────────────
  /// The one session this account is allowed to have. Every access token
  /// carries the session id it was minted under; a token whose `sid` no longer
  /// matches is refused, so signing in on a second device signs the first one
  /// out rather than letting one login be shared between two people.
  /// Null means "never signed in", not "any session is acceptable".
  activeSessionId   String?
  /// Where and when that session started — shown to the displaced user so an
  /// unexpected sign-out is explainable rather than alarming.
  sessionStartedAt  DateTime?
  sessionUserAgent  String?
  sessionIp         String?
  /// ── two-factor authentication ───────────────────────────────────────────
  /// Base32 TOTP secret. Present but unconfirmed while enrolment is in
  /// progress; `totpEnabledAt` is what decides whether 2FA is actually on, so
  /// an abandoned enrolment can never lock anyone out.
  totpSecret        String?
  totpEnabledAt     DateTime?
  /// Single-use recovery codes, stored as SHA-256 hashes — never in the clear,
  /// and shown to the user exactly once at enrolment.
  totpRecoveryCodes String[]             @default([])
  grantsMade        CompanyMembership[]  @relation("MembershipGrantedBy")
  memberships       CompanyMembership[]  @relation("MembershipUser")
  uploads           Document[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  assignedTasks     Task[]               @relation("TaskAssignee")
  initiatedPayments Payment[]            @relation("PaymentCreator")
  reviewedProposals RuleChangeProposal[]
  overlaysCreated   RuleOverlay[]        @relation("OverlayCreatedBy")
  overlaysRevoked   RuleOverlay[]        @relation("OverlayRevokedBy")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Who may see and work a given company.
///
/// SUPER_ADMIN and ADMIN see every company in the organisation and need no row
/// here. Everyone else sees only the companies they hold a membership for, which
/// is what lets a client's own login see nothing but their own entity.
model CompanyMembership {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  /// Capability on this company specifically — a practitioner may be CA on one
  /// client and VIEWER on another.
  role        UserRole
  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grantedBy   User?    @relation("MembershipGrantedBy", fields: [grantedById], references: [id])
  user        User     @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("company_memberships")
}

model Company {
  id                            String                    @id @default(uuid())
  organizationId                String
  legalName                     String
  brandName                     String?
  entityType                    EntityType
  /// Kind of unincorporated business — a yes/no for the entity type slide.
  /// Records what kind of shop or profession this is: SHOP_RETAIL, FREELANCER,
  /// PROFESSIONAL, FOOD_RESTAURANT, OTHER. Display-only: drives no rules.
  businessType                  String?
  cin                           String?
  llpin                         String?
  pan                           String?
  tan                           String?
  incorporationDate             DateTime?                 @db.Date
  stateCode                     String
  industry                      String?
  employeeCount                 Int                       @default(0)
  annualTurnover                BigInt                    @default(0)
  paidUpCapital                 BigInt                    @default(0)
  authorisedCapital             BigInt                    @default(0)
  registeredAddress             String?
  companyStatus                 String?
  companyCategory               String?
  companySubCategory            String?
  companyClass                  String?
  cashTransactionRatioBelow5Pct Boolean                   @default(true)
  hasForeignTransactions        Boolean                   @default(false)
  acceptsDeposits               Boolean                   @default(false)
  isListed                      Boolean                   @default(false)
  buysFromMsmeSuppliers         Boolean                   @default(true)
  financialYearEndMonth         Int                       @default(3)
  agmDate                       DateTime?                 @db.Date
  isActive                      Boolean                   @default(true)
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  /// Registrations the entity holds rather than obligations it owes. They drive
  /// no rules today — they are what a reviewer asks for first, so the dashboard
  /// shows them. Formats vary by issuing office, so none is asserted here.
  dpiitRecognitionNumber        String?
  dpiitRecognisedOn             DateTime?                 @db.Date
  epfoCode                      String?
  esicCode                      String?
  shopAndEstablishment          String?
  fssaiNumber                   String?
  professionalTax               String?
  tradeLicense                  String?
  profileConfirmedAt            DateTime?
  logoStorageKey                String?
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships                   CompanyMembership[]
  applicabilities               ComplianceApplicability[]
  items                         ComplianceItem[]
  scoreSnapshots                ComplianceScoreSnapshot[]
  directors                     Director[]
  documents                     Document[]
  gstRegistrations              GstRegistration[]
  msmeRegistration              MsmeRegistration?
  payments                      Payment[]

  @@unique([organizationId, legalName])
  @@index([organizationId])
  @@map("companies")
}

model CompanyEvent {
  id        String   @id @default(uuid())
  companyId String
  eventType String
  eventDate DateTime
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([companyId, eventType, eventDate])
  @@index([companyId])
  @@map("company_events")
}

model Director {
  id           String    @id @default(uuid())
  companyId    String
  name         String
  din          String?
  email        String?
  designation  String    @default("Director")
  appointedOn  DateTime? @db.Date
  resignedOn   DateTime? @db.Date
  status       String?
  isResident   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// A filing that needs signing cannot go out on an expired certificate, so the
  /// expiry is what matters here rather than the certificate itself.
  dscExpiresOn DateTime? @db.Date
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("directors")
}

model GstRegistration {
  id                  String             @id @default(uuid())
  companyId           String
  gstin               String
  stateCode           String
  legalName           String?
  tradeName           String?
  constitution        String?
  filingFrequency     GstFilingFrequency @default(MONTHLY)
  isTdsDeductor       Boolean            @default(false)
  isEcommerceOperator Boolean            @default(false)
  registeredOn        DateTime?          @db.Date
  isActive            Boolean            @default(true)
  certificateKey      String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, gstin])
  @@index([companyId])
  @@map("gst_registrations")
}

model MsmeRegistration {
  id             String       @id @default(uuid())
  companyId      String       @unique
  udyamNumber    String
  enterpriseName String?
  category       MsmeCategory
  majorActivity  String?
  socialCategory String?
  registeredOn   DateTime?    @db.Date
  certificateKey String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("msme_registrations")
}

/// Snapshot of why a rule does / does not apply to a company. Auditable.
model ComplianceApplicability {
  id          String   @id @default(uuid())
  companyId   String
  ruleCode    String
  applicable  Boolean
  reasons     Json
  evaluatedAt DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ruleCode])
  @@index([companyId, applicable])
  @@map("compliance_applicabilities")
}

/// One row per (company, rule, period) — this is the compliance calendar.
model ComplianceItem {
  id               String         @id @default(uuid())
  companyId        String
  ruleCode         String
  title            String
  authority        Authority
  category         String
  form             String?
  legalReference   String
  severity         Severity
  periodKey        String
  periodLabel      String
  periodStart      DateTime       @db.Date
  periodEnd        DateTime       @db.Date
  dueDate          DateTime       @db.Date
  status           ItemStatus     @default(UPCOMING)
  completedAt      DateTime?
  waivedReason     String?
  penaltyNote      String?
  evidenceRequired String[]       @default([])
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// Set when an ATTEST obligation is closed with a declaration rather than a
  /// document. Kept on the item so the claim, its author and its timestamp
  /// travel with the record an auditor will actually read.
  attestationText  String?
  attestedAt       DateTime?
  attestedById     String?
  evidenceLevel    EvidenceLevel  @default(NONE)
  /// The person who signed the evidence, for rules whose document carries a
  /// human signature. Software cannot verify a scanned signature, so a named
  /// accountable person is the control that replaces it.
  signatoryName    String?
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents        Document[]
  notifications    Notification[]
  task             Task?

  @@unique([companyId, ruleCode, periodKey])
  @@index([companyId, dueDate])
  @@index([companyId, status])
  @@index([dueDate, status])
  @@map("compliance_items")
}

model Task {
  id               String         @id @default(uuid())
  complianceItemId String         @unique
  companyId        String
  title            String
  description      String?
  status           TaskStatus     @default(TODO)
  assigneeId       String?
  dueDate          DateTime       @db.Date
  checklist        Json           @default("[]")
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  documents        Document[]
  assignee         User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  complianceItem   ComplianceItem @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Document {
  id                  String          @id @default(uuid())
  companyId           String
  complianceItemId    String?
  taskId              String?
  fileName            String
  storageKey          String          @unique
  storageDriver       String          @default("supabase")
  mimeType            String
  sizeBytes           Int
  sha256              String
  label               String?
  uploadedById        String?
  createdAt           DateTime        @default(now())
  /// Recorded at upload from the file's actual contents, not the client's claim.
  detectedType        String?
  hasDigitalSignature Boolean         @default(false)
  pdfPages            Int?
  signedAt            DateTime?
  /// Common names read out of the signing certificates, best effort.
  signers             String[]        @default([])
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complianceItem      ComplianceItem? @relation(fields: [complianceItemId], references: [id])
  task                Task?           @relation(fields: [taskId], references: [id])
  uploadedBy          User?           @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
  @@index([complianceItemId])
  @@map("documents")
}

model Notification {
  id               String              @id @default(uuid())
  userId           String?
  complianceItemId String?
  channel          NotificationChannel @default(EMAIL)
  kind             String
  subject          String
  body             String
  status           NotificationStatus  @default(PENDING)
  error            String?
  sentAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime            @default(now())
  complianceItem   ComplianceItem?     @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)
  user             User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([complianceItemId, userId, kind])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  actorEmail     String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One row per scheduled job execution.
///
/// The unique (jobName, scheduledFor) is how concurrent replicas agree on who
/// runs the job: whoever inserts the row first owns it, everyone else backs off.
/// It doubles as the job history for monitoring and alerting.
model JobRun {
  id           String    @id @default(uuid())
  jobName      String
  /// The logical slot this run belongs to — the date for a daily job.
  scheduledFor DateTime  @db.Date
  status       JobStatus @default(RUNNING)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  result       Json?
  error        String?
  /// Which container/pod claimed it, for tracing a failure back to a host.
  claimedBy    String?

  @@unique([jobName, scheduledFor])
  @@index([jobName, startedAt])
  @@map("job_runs")
}

/// One Razorpay transaction, attributed to the organisation whose subscription
/// it pays for and to the company the owner was upgrading. The single source of
/// truth for both the per-company billing history and the SUPER_ADMIN platform
/// analytics — nothing is ever derived from a hardcoded number or a client claim.
///
/// Amount, plan and method are recorded server-side only: the amount comes from
/// the order this server created, and the method from a verify/webhook path that
/// fetches the payment from Razorpay. The frontend never supplies any of them.
model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  /// Which company the owner was upgrading. Null when the upgrade was not
  /// attached to a single company (organisation-level purchase).
  companyId       String?
  createdByUserId String?
  rzxOrderId      String        @unique
  /// Set only from server-side signature verification or a verified webhook —
  /// never from a value the client presents.
  rzxPaymentId    String?       @unique
  rzxSignature    String?
  /// Actual charged amount in paise, from the order this server created.
  amountPaise     Int
  currency        String        @default("INR")
  /// Plan name at purchase time, from config — audited here, displayed there.
  planName        String
  status          PaymentStatus @default(CREATED)
  /// "card" / "upi" / ... — from the Razorpay payment object, never a client claim.
  method          String?
  paidAt          DateTime?
  /// Length of the entitlement this payment bought: payment date + plan period.
  validUntil      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy       User?         @relation("PaymentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([companyId, createdAt])
  @@index([paidAt])
  @@map("payments")
}

model ComplianceScoreSnapshot {
  id         String   @id @default(uuid())
  companyId  String
  score      Int
  band       String
  breakdown  Json
  capturedAt DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, capturedAt])
  @@map("compliance_score_snapshots")
}

/// ---------------------------------------------------------------------------
/// Regulatory watch
///
/// A Claude-driven job reads what MCA, CBIC, CBDT, EPFO, ESIC, the MSME
/// ministry and DPIIT have published, and writes what it found here. Nothing in
/// these tables changes a single obligation on its own: a finding becomes a
/// proposal, a proposal becomes an overlay only when a human approves it, and
/// only an overlay is read by the engine.
/// ---------------------------------------------------------------------------

/// One circular, notification, amendment rule or press release the watcher
/// found. Deduplicated on `fingerprint`, so re-running the job — daily, or after
/// a failure — never produces the same update twice.
model RegulatoryUpdate {
  id            String               @id @default(uuid())
  authority     Authority
  /// The issuing reference where there is one, e.g. "General Circular 09/2026".
  referenceNo   String?
  title         String
  summary       String
  url           String
  publishedOn   DateTime?            @db.Date
  /// Circular / Notification / Amendment Rules / Press Release / Order.
  documentType  String?
  /// Stable hash over authority + reference + title + url. The dedupe key.
  fingerprint   String               @unique
  /// What the watcher believes this changes, in plain English. Null when it
  /// found the document relevant but could not tie it to a specific obligation.
  impactSummary String?
  /// The model's raw finding, kept verbatim so a reviewer can audit the
  /// reasoning behind a proposal rather than taking the patch on trust.
  raw           Json?
  discoveredAt  DateTime             @default(now())
  /// The job run that found it — ties a batch of updates back to one sweep.
  jobRunId      String?
  proposals     RuleChangeProposal[]

  @@index([authority, publishedOn])
  @@index([discoveredAt])
  @@map("regulatory_updates")
}

/// A drafted change to one rule, awaiting review.
///
/// `patch` is a RuleOverlayPatch (see src/engine/overlay.ts) and is validated
/// against the engine's predicate registry before the row is written — a
/// proposal that cannot be expressed as data is stored as CODE_CHANGE_REQUIRED
/// with the patch left empty, so an engineer picks it up instead of it being
/// silently dropped.
model RuleChangeProposal {
  id            String           @id @default(uuid())
  updateId      String
  update        RegulatoryUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  /// Null only for a NEW_RULE proposal, which no overlay can express.
  ruleCode      String?
  changeKind    RuleChangeKind
  status        ProposalStatus   @default(PENDING)
  title         String
  rationale     String
  patch         Json
  /// The model's own 0-1 confidence. Advisory — it gates nothing by itself.
  confidence    Float
  /// Source URLs backing the claim. A proposal with none should not be approved.
  citations     Json
  /// Which companies this would touch, in plain English, e.g. "Pvt Ltd with
  /// turnover over ₹5 crore". Written for the reviewer, not parsed.
  appliesToNote String?
  reviewedById  String?
  reviewedBy    User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  overlayId     String?          @unique
  overlay       RuleOverlay?     @relation(fields: [overlayId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([ruleCode])
  @@map("rule_change_proposals")
}

/// An approved, data-only amendment the engine actually applies.
///
/// This is the only table in this group the rule engine ever sees, and it sees
/// it through one injection point: the runtime loads ACTIVE rows and pushes
/// them into setRuleOverlays(). Revoking a row restores the committed catalog
/// behaviour on the next refresh.
model RuleOverlay {
  id            String              @id @default(uuid())
  ruleCode      String
  patch         Json
  /// Null bounds mean "since forever" / "until further notice".
  effectiveFrom DateTime?           @db.Date
  effectiveTo   DateTime?           @db.Date
  status        OverlayStatus       @default(ACTIVE)
  /// Shown to users as the reason an obligation changed. Cite the circular.
  note          String?
  createdById   String?
  createdBy     User?               @relation("OverlayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedById   String?
  revokedBy     User?               @relation("OverlayRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt     DateTime?
  revokeReason  String?
  proposal      RuleChangeProposal?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([ruleCode, status])
  @@map("rule_overlays")
}

/// What kind of change a proposal represents. Drives how a reviewer reads it
/// and how much scrutiny it deserves — a TEXT_UPDATE is cosmetic, an
/// APPLICABILITY_CHANGE can add or remove an obligation for every customer.
enum RuleChangeKind {
  DUE_DATE_SHIFT
  DUE_DATE_OVERRIDE
  THRESHOLD_CHANGE
  APPLICABILITY_CHANGE
  EVIDENCE_CHANGE
  PENALTY_CHANGE
  TEXT_UPDATE
  SUSPENSION
  WITHDRAWAL
  NEW_RULE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  /// Real, but not expressible as a data overlay — needs a catalog edit.
  CODE_CHANGE_REQUIRED
  /// A later proposal for the same rule replaced this one before review.
  SUPERSEDED
}

enum OverlayStatus {
  ACTIVE
  REVOKED
}

enum EntityType {
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OPC
  LLP
  PARTNERSHIP
  PROPRIETORSHIP
  SECTION_8
  UNREGISTERED
}

/// Roles within one organisation. Tenant isolation is by organisation and is
/// never crossed — a SUPER_ADMIN is the top of *their* firm, not the installation.
enum UserRole {
  /// Sees every company in the organisation, manages users and grants access.
  SUPER_ADMIN
  /// Sees every company in the organisation; cannot manage users or grants.
  ADMIN
  /// Practitioner. Sees only the companies they have been granted, and works them.
  CA
  /// A client's own login. Sees only their company; uploads evidence, cannot reshape the profile.
  COMPANY_OWNER
  /// Read-only, on granted companies only.
  VIEWER
}

enum Authority {
  MCA
  GST
  INCOME_TAX
  MSME
  LABOUR
  DPIIT
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ItemStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
  WAIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

/// How completion of an obligation must be proved. See src/engine/types.ts.
enum EvidenceLevel {
  REQUIRED
  ATTEST
  NONE
}

enum GstFilingFrequency {
  MONTHLY
  QRMP
  COMPOSITION
}

enum MsmeCategory {
  MICRO
  SMALL
  MEDIUM
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Lifecycle of one Razorpay order/payment, as the server saw it act on it.
enum PaymentStatus {
  /// Order created server-side; checkout not finished or payment not confirmed.
  CREATED
  /// A verified webhook confirmed the capture before the user's verify call
  /// landed (or the verify call is still pending).
  AUTHORIZED
  /// Server-side signature verification passed.
  SUCCESS
  /// payment.failed from a verified webhook.
  FAILED
  /// Captured then refunded.
  REFUNDED
}
